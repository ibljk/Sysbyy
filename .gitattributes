# ============================================================
# 行尾策略：仓库内统一以 LF 存储，避免跨平台执行问题
# ============================================================

# 让 git 自动识别文本/二进制
* text=auto

# Shell 脚本必须是 LF —— 云端（Linux）与 CI 直接执行，CRLF 会报
# “/bin/bash^M: bad interpreter”
*.sh   text eol=lf
*.bash text eol=lf

# Windows 批处理必须是 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做任何行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.jar   binary
*.pptx  binary
